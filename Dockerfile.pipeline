# syntax=docker/dockerfile:1
# Образ с пайплайном обработки NetCDF → JSON.
# Позволяет пересобрать данные без установки Python и netCDF4 на компьютер:
#   docker compose run --rm pipeline

FROM python:3.12-slim@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b

# Временная заплатка до пересборки базового образа: исправление zstd (CVE-2026-124851) уже есть
# в репозитории безопасности Debian, а образ python:3.12-slim с ним ещё не вышел. Обновляется только
# этот пакет; когда Dependabot принесёт digest с исправлением, команда ничего не изменит — тогда удалить.
# (Прежняя заплатка zlib, CVE-2026-85091, удалена: исправление уже внутри этого digest.)
# Версия не закреплена намеренно: нужна «не ниже исправленной», а репозиторий безопасности Debian хранит
# только последнюю — закреплённая версия сломала бы сборку при следующем исправлении (hadolint DL3008).
# hadolint ignore=DL3008
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --only-upgrade libzstd1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Сначала зависимости — этот слой кэшируется и не пересобирается при изменении скриптов
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ scripts/
COPY config/ config/

# Работаем не от root (числовой UID — чтобы права на смонтированные папки были предсказуемыми)
RUN useradd --create-home --uid 1000 app
USER 1000

# Разовая задача, а не сервис: проверка живости не нужна (явно — для сканеров, Trivy DS-0026)
HEALTHCHECK NONE

ENTRYPOINT ["python", "scripts/process_tcr2.py"]
CMD ["--help"]
