# Обратный прокси. Файл создаёт Ansible (роль proxy) — правки вручную будут перезаписаны.
{
	# Сертификаты выпускает собственный центр сертификации Caddy: публичный (Let's Encrypt)
	# не может проверить имена домашней сети, а сервер за CGNAT недоступен из интернета.
	local_certs
	# Корневой сертификат ставится в доверенные на устройствах, а не внутри контейнера
	skip_install_trust
	# Корень центра сертификации — из файлов, которые кладёт Ansible (из vault), а не сгенерированный
	# в томе: так он переживает переустановку сервера. Промежуточный сертификат (живёт 7 дней)
	# Caddy выпускает и обновляет сам, подписывая его этим корнем
	pki {
		ca local {
			root {
				cert {{ proxy_ca_container_dir }}/root.crt
				key {{ proxy_ca_container_dir }}/root.key
			}
		}
	}
	# Метрики HTTP-запросов с разбивкой по сайтам (без этой опции Caddy их не считает)
	metrics {
		per_host
	}
}

# Метрики для Prometheus. Порт на хосте не опубликован; отвечаем только сети мониторинга
http://:{{ proxy_metrics_port }} {
	@outside not remote_ip {{ proxy_metrics_sources | join(' ') }}
	respond @outside "Forbidden" 403

	metrics
}
{% for site in proxy_sites %}

{{ site.host }} {
{% if site.allowed_sources is defined %}
	# Сайт только для перечисленных адресов. remote_ip — адрес самого соединения:
	# заголовку X-Forwarded-For здесь верить нельзя, его присылает клиент
	@outside not remote_ip {{ site.allowed_sources | join(' ') }}
	respond @outside "Forbidden" 403

{% endif %}
	# Сжимает прокси, а не сайт: nginx по умолчанию не сжимает ответы на запросы,
	# пришедшие через прокси (заголовок Via), — см. gzip_proxied
	encode zstd gzip
	reverse_proxy {{ site.upstream }}
}
{% endfor %}
