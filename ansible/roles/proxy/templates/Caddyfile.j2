# Обратный прокси. Файл создаёт Ansible (роль proxy) — правки вручную будут перезаписаны.
{
	# Сертификаты выпускает собственный центр сертификации Caddy: публичный (Let's Encrypt)
	# не может проверить имена домашней сети, а сервер за CGNAT недоступен из интернета.
	local_certs
	# Корневой сертификат ставится в доверенные на устройствах, а не внутри контейнера
	skip_install_trust
}
{% for site in proxy_sites %}

{{ site.host }} {
	# Сжимает прокси, а не сайт: nginx по умолчанию не сжимает ответы на запросы,
	# пришедшие через прокси (заголовок Via), — см. gzip_proxied
	encode zstd gzip
	reverse_proxy {{ site.upstream }}
}
{% endfor %}
