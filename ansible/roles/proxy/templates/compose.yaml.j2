# Обратный прокси. Файл создаёт Ansible (роль proxy) — правки вручную будут перезаписаны.
name: proxy

services:
  caddy:
    image: {{ proxy_image }}
    restart: unless-stopped
    # Единственные порты сервера для веб-трафика; HTTP нужен только для перенаправления на HTTPS
    ports:
      - "80:80"
      - "443:443"
    volumes:
      # Монтируется каталог, а не файл: при обновлении файл заменяется новым, и контейнер
      # с примонтированным файлом продолжал бы видеть старый
      - ./conf:/etc/caddy:ro
      - caddy_data:/data        # центр сертификации и выпущенные сертификаты
      - caddy_config:/config
    networks:
      - proxy
    healthcheck:
      # API управления слушает только внутри контейнера
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 3s
      start_period: 10s
      start_interval: 2s
      retries: 3
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE          # слушать порты 80 и 443
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ proxy_memory_limit }}
    cpus: "{{ proxy_cpus }}"
    pids_limit: {{ proxy_pids_limit }}

volumes:
  caddy_data:
  caddy_config:

networks:
  proxy:
    external: true                # общую сеть создаёт роль docker
