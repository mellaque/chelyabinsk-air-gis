{
  "uid": "air-gis-containers",
  "title": "Контейнеры",
  "description": "Метрики контейнеров Docker из cAdvisor",
  "tags": [
    "air-gis",
    "containers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
