# Мониторинг. Файл создаёт Ansible (роль monitoring) — правки вручную будут перезаписаны.
# Ни одного опубликованного порта: Prometheus, Alertmanager и Grafana открываются через обратный прокси
# (сеть monitoring).
name: monitoring

services:
  prometheus:
    image: {{ monitoring_prometheus_image }}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_retention_time }}
      - --storage.tsdb.retention.size={{ monitoring_retention_size }}
      - --web.external-url={{ monitoring_prometheus_url }}
    volumes:
      # Монтируется каталог, а не файл: при обновлении файл заменяется новым, и контейнер
      # с примонтированным файлом продолжал бы видеть старый
      - ./prometheus:/etc/prometheus:ro
      - prometheus_data:/prometheus
    networks:
      - monitoring
    healthcheck:
      # ready, а не healthy: после перезапуска Prometheus сначала читает журнал (WAL) и не отвечает на запросы
      test: ["CMD", "promtool", "check", "ready", "--url=http://127.0.0.1:9090"]
      interval: 30s
      timeout: 5s
      start_period: 90s
      start_interval: 2s
      retries: 3
    read_only: true               # пишет только в том с данными
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ monitoring_prometheus_memory_limit }}
    cpus: "{{ monitoring_prometheus_cpus }}"
    pids_limit: {{ monitoring_pids_limit }}

  alertmanager:
    image: {{ monitoring_alertmanager_image }}
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.external-url={{ monitoring_alertmanager_url }}
      # Пустой адрес выключает режим кластера: экземпляр один, порт 9094 для обмена между узлами не нужен
      - --cluster.listen-address=
    volumes:
      - ./alertmanager:/etc/alertmanager:ro
      # Каталог, а не файл (и не secrets: compose): адрес канала Alertmanager читает при каждой
      # отправке, а примонтированный отдельно файл после замены остался бы прежним
      - ./secrets/alertmanager:/run/secrets:ro
      # Заглушки и журнал отправленных уведомлений: без тома после перезапуска всё пришло бы повторно
      - alertmanager_data:/alertmanager
    networks:
      - monitoring
    read_only: true               # пишет только в том с данными
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ monitoring_alertmanager_memory_limit }}
    cpus: "{{ monitoring_exporter_cpus }}"
    pids_limit: {{ monitoring_pids_limit }}

  # У экспортёров нет healthcheck: работают ли они, показывает метрика up в Prometheus,
  # а роль в конце прогона проверяет, что опрошены все цели.
  node-exporter:
    image: {{ monitoring_node_exporter_image }}
    restart: unless-stopped
    command:
      - --path.rootfs=/host
      # Только адрес шлюза сети monitoring: из локальной сети порт недоступен, даже если firewall выключен
      - --web.listen-address={{ monitoring_gateway }}:{{ monitoring_node_exporter_port }}
    # Сеть и процессы хоста: иначе экспортёр видел бы интерфейсы и процессы контейнера, а не сервера
    network_mode: host
    pid: host
    volumes:
      - /:/host:ro,rslave         # файловые системы хоста, только чтение
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ monitoring_exporter_memory_limit }}
    cpus: "{{ monitoring_exporter_cpus }}"
    pids_limit: {{ monitoring_pids_limit }}

  # Метрики контейнеров. Работает без --privileged и без capabilities — проверено на этом сервере:
  # не работает только счётчик OOM (ему нужен /dev/kmsg).
  # Компромисс: cAdvisor нужен сокет Docker (внутри /var/run) — по нему он узнаёт имена контейнеров.
  # Монтирование «только чтение» API не ограничивает: доступ к сокету равен правам root на сервере.
  # Поэтому у контейнера нет опубликованных портов, а метрики он отдаёт только в сеть monitoring.
  cadvisor:
    image: {{ monitoring_cadvisor_image }}
    restart: unless-stopped
    command:
      - --docker_only=true        # только контейнеры Docker и сервер целиком, без остальных cgroup
      - --housekeeping_interval={{ monitoring_cadvisor_interval }}
      - --allow_dynamic_housekeeping=false
      - --enable_metrics={{ monitoring_cadvisor_metrics | join(',') }}
      - --store_container_labels=false
      - --whitelisted_container_labels={{ monitoring_cadvisor_labels | join(',') }}
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    networks:
      - monitoring
    healthcheck:
      disable: true               # как у остальных экспортёров: состояние показывает метрика up
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ monitoring_cadvisor_memory_limit }}
    cpus: "{{ monitoring_exporter_cpus }}"
    pids_limit: {{ monitoring_pids_limit }}

  blackbox:
    image: {{ monitoring_blackbox_image }}
    restart: unless-stopped
    command:
      - --config.file=/etc/blackbox/blackbox.yml
    volumes:
      - ./blackbox:/etc/blackbox:ro
    networks:
      - monitoring
    read_only: true
    cap_drop:
      - ALL                       # только HTTP-проверки; для ICMP понадобился бы NET_RAW
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ monitoring_exporter_memory_limit }}
    cpus: "{{ monitoring_exporter_cpus }}"
    pids_limit: {{ monitoring_pids_limit }}

  # Дашборды и источник данных Grafana читает из файлов (provisioning): в её базе нет ничего,
  # что нельзя восстановить из репозитория, и том можно удалить без потерь.
  grafana:
    image: {{ monitoring_grafana_image }}
    restart: unless-stopped
    environment:
      GF_SERVER_ROOT_URL: {{ monitoring_grafana_url }}
      GF_SECURITY_ADMIN_USER: {{ monitoring_grafana_admin_user }}
      # Пароль читается из файла: в переменной окружения его показал бы docker inspect
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_SECURITY_COOKIE_SECURE: "true"
      GF_USERS_ALLOW_SIGN_UP: "false"
      # Ничего не отправлять наружу и не ходить за обновлениями и плагинами
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_PLUGINS_PLUGIN_ADMIN_ENABLED: "false"
      # Иначе при каждом запуске Grafana скачивает обновления встроенных плагинов (CloudWatch,
      # Elasticsearch и других) — они здесь не используются, а память и трафик тратят
      GF_PLUGINS_PREINSTALL_AUTO_UPDATE: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /etc/grafana/dashboards/{{ monitoring_grafana_home_dashboard }}
    secrets:
      - grafana_admin_password
    volumes:
      - ./grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ./grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
      - grafana_data:/var/lib/grafana
    networks:
      - monitoring
    read_only: true               # пишет только в том с данными и во временный каталог
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ monitoring_grafana_memory_limit }}
    cpus: "{{ monitoring_prometheus_cpus }}"
    pids_limit: {{ monitoring_grafana_pids_limit }}

secrets:
  grafana_admin_password:
    file: {{ monitoring_dir }}/secrets/grafana-admin-password

volumes:
  prometheus_data:
  alertmanager_data:
  grafana_data:

networks:
  monitoring:
    external: true                # общую сеть создаёт роль docker
