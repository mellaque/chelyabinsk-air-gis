# Molecule: образ для теста роли docker — Debian 13 с systemd в роли PID 1.
# Не «Dockerfile», чтобы его не считали Dockerfile проекта (hadolint, Trivy): это тестовый стенд,
# он работает от root и без healthcheck намеренно.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV container=docker

# То, что на настоящем сервере есть до роли docker: systemd, sudo (become — как на сервере),
# Python и python3-apt (модули Ansible) и ca-certificates — роль скачивает ключ и пакеты Docker
# по HTTPS. На сервере ca-certificates ставит установщик Debian, в slim-образе его нет.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       systemd systemd-sysv dbus python3 python3-apt ca-certificates sudo \
    && rm -rf /var/lib/apt/lists/*

# systemd завершается по этому сигналу, а не по SIGTERM
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
